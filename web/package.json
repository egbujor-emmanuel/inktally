{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile.json=../evidence/vitest.json",
    "evidence:verify": "node scripts/verify-evidence.mjs",
    "ci:clean": "npm run lint && npm run test:report && npm run build && npm run evidence:verify"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "exceljs": "^4.4.0",
    "firebase": "^13.2.0",
    "gsap": "^3.15.1",
    "idb": "^8.0.4",
    "jspdf": "^3.0.3",
    "lenis": "^1.3.27",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "lighthouse": "^12.8.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
