# Copy to .env.local and fill in from the Firebase console (Project settings > Your apps > Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Local development only: App Check debug token registered in the console (Security > App Check > Manage debug tokens).
VITE_APPCHECK_DEBUG_TOKEN=
# Production: reCAPTCHA Enterprise site key registered for App Check.
VITE_RECAPTCHA_SITE_KEY=
# Optional private-preview gate: SHA-256 hex of an access code. Leave empty to make the site public.
VITE_ACCESS_CODE_SHA256=
