rules_version = '2';
// Each teacher can only read and write their own assignments, marks and telemetry.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.ownerUid == request.auth.uid; }

    match /assignments/{assignmentId} {
      // resource == null: a listener can attach before a just-created (still queued) doc reaches the
      // server. Reading a doc that does not exist reveals nothing, so allow it instead of killing the listener.
      allow read: if resource == null || owns(resource.data);
      allow create: if owns(request.resource.data)
        && request.resource.data.keys().hasAll(['title', 'className', 'scheme', 'ownerUid']);
      allow update: if owns(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owns(resource.data);

      match /submissions/{submissionId} {
        allow read: if resource == null || owns(resource.data);
        allow create: if owns(request.resource.data)
          && get(/databases/$(database)/documents/assignments/$(assignmentId)).data.ownerUid == request.auth.uid;
        allow update: if owns(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid
          && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 1000))
          && request.resource.data.pupil is string && request.resource.data.pupil.size() <= 120;
        allow delete: if owns(resource.data);
      }
    }

    match /users/{userId}/telemetry/{day} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Institution details shown on sheets, marked copies and the register.
    match /users/{userId}/settings/profile {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['institution', 'details', 'teacher', 'updatedAt'])
        && request.resource.data.institution is string && request.resource.data.institution.size() <= 120
        && request.resource.data.details is string && request.resource.data.details.size() <= 240
        && request.resource.data.teacher is string && request.resource.data.teacher.size() <= 80;
    }
  }
}
